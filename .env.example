# Port the Node server listens on. Render sets this automatically.
PORT=3000

# Public base URL used by the keep-alive ping (GET <url>/api/health every 10 min
# while at least one socket is open). On Render, RENDER_EXTERNAL_URL is set for
# you and takes precedence. Leave both unset to disable the ping.
# APP_URL=https://storypoker.example.com
